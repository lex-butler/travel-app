rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Any authenticated user can read profiles (needed for member lists)
    // Only the owner can write their own profile
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Trips
    match /trips/{tripId} {
      // Any authenticated user can create a trip they own
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;

      // Members can read the trip
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.memberIds;

      // Members can update; also allow a user to add themselves (invite acceptance)
      allow update: if request.auth != null
                    && (
                      request.auth.uid in resource.data.memberIds
                      || (
                        request.auth.uid in request.resource.data.memberIds
                        && !(request.auth.uid in resource.data.memberIds)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
                      )
                    );

      // Only the owner can delete
      allow delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;
    }

    // Invites — stored by token (token is the document ID)
    match /invites/{token} {
      // Anyone can read an invite (needed to display trip info before login)
      allow read: if true;

      // Authenticated trip members can create invites
      allow create: if request.auth != null;

      // Authenticated users can update invite status (e.g. accept/decline)
      allow update: if request.auth != null;
    }
  }
}
